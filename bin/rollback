#!/usr/bin/env bash
# Vuelve producción a una versión etiquetada (ubuntu, ~/services/quantum-fm, systemd «quantum-fm»).
#
#   bin/rollback --seco            dice a qué versión volvería y comprueba que existe; no toca nada
#   bin/rollback                   vuelve a la versión anterior a la desplegada
#   bin/rollback v2026.11.22-1     vuelve a esa versión (etiqueta o commit)
#
# Hace: comprobar la etiqueta → checkout de ESE commit en ~/services/quantum-fm → npm ci si
# cambió el lock → reinicio del servicio → sonda /up → aviso a la flota.
# NO restaura la base: si entre las dos versiones hay migraciones, lo dice y para (eso lo
# decide Héctor). El próximo bin/deploy vuelve a origin/main.
set -euo pipefail

main() {
  local aqui; aqui="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck source=bin/_comun.sh
  source "$aqui/_comun.sh"

  local seco="" objetivo=""
  for arg in "$@"; do
    case "$arg" in
      --seco|--dry-run) seco=1 ;;
      -h|--help) sed -n '2,12p' "${BASH_SOURCE[0]}"; exit 0 ;;
      -*) error "opción desconocida: $arg"; exit 2 ;;
      *) objetivo="$arg" ;;
    esac
  done

  [[ -d "$QFM_DIR/.git" ]] || { error "no existe $QFM_DIR"; exit 1; }
  [[ -n "$seco" ]] || candado
  [[ -n "${QFM_ROLLBACK_AUTO:-}" ]] || traer_etiquetas

  local actual actual_tag
  actual="$(g rev-parse HEAD)"
  actual_tag="$(etiqueta_de "$actual")"
  info "en producción: ${actual_tag:-sin etiqueta} ($(g rev-parse --short "$actual"))"

  if [[ -z "$objetivo" && -s "$QFM_STATE/anterior" ]]; then
    # La que corría antes del último bin/deploy, si existe y no es la actual.
    local guardada; guardada="$(head -n1 "$QFM_STATE/anterior")"
    if [[ -n "$guardada" ]] && g rev-parse -q --verify "$guardada^{commit}" >/dev/null 2>&1 \
       && [[ "$(g rev-parse "$guardada^{commit}")" != "$actual" ]]; then
      objetivo="$guardada"
    fi
  fi
  if [[ -z "$objetivo" ]]; then
    # Si no: la etiqueta más reciente anterior a la actual que apunte a otro commit.
    local t
    while read -r t; do
      [[ -n "$t" ]] || continue
      [[ -n "$actual_tag" && "$t" == "$actual_tag" ]] && break
      [[ "$(g rev-parse "$t^{commit}")" != "$actual" ]] && objetivo="$t"
    done < <(etiquetas)
    if [[ -z "$objetivo" ]]; then
      error "no hay una versión anterior etiquetada a la que volver"
      info "etiquetas: $(etiquetas | tr '\n' ' ')"
      exit 1
    fi
  fi

  local destino
  if ! destino="$(g rev-parse -q --verify "$objetivo^{commit}" 2>/dev/null)"; then
    error "la versión $objetivo no existe en $QFM_DIR"; exit 1
  fi
  info "versión destino: $objetivo ($(g rev-parse --short "$destino")) — existe"

  # La base no se restaura: si hay migraciones entre las dos versiones, se para.
  local migraciones
  migraciones="$(g diff --name-only "$destino" "$actual" -- migrations db/migrate 'lib/migrations' 2>/dev/null || true)"
  if [[ -n "$migraciones" ]]; then
    error "entre $objetivo y la versión actual hay migraciones de base:"; printf '%s\n' "$migraciones" | sed 's/^/  /' >&2
    error "bin/rollback NO restaura la base; decide Héctor (copia: ~/services/quantum-fm-backup.sh)"
    exit 3
  fi

  if [[ "$destino" == "$actual" ]]; then
    info "producción ya está en $objetivo"; [[ -n "$seco" ]] && exit 0
    sonda "$destino"; exit $?
  fi

  if [[ -n "$seco" ]]; then
    info "[seco] haría: checkout $objetivo en $QFM_DIR, npm ci si cambia el lock, systemctl --user restart $QFM_UNIT, sonda $(url_sonda)"
    if [[ -n "$(g status --porcelain --untracked-files=no)" ]]; then
      aviso "[seco] $QFM_DIR tiene cambios sin commitear: el rollback de verdad se pararía"
    fi
    exit 0
  fi

  if [[ -n "$(g status --porcelain --untracked-files=no)" ]]; then
    error "$QFM_DIR tiene cambios sin commitear; no se hace rollback"; exit 1
  fi

  info "rollback $(g rev-parse --short "$actual") → $objetivo"
  g checkout -q --detach "$destino"
  if dependencias && reiniciar && sonda "$destino"; then
    rm -f "$QFM_STATE/anterior"
    avisar "Quantum FM: rollback a $objetivo hecho" \
      "Producción vuelve a $objetivo ($(g rev-parse --short "$destino")) desde ${actual_tag:-$(g rev-parse --short "$actual")}. Sonda en verde. El próximo bin/deploy vuelve a origin/main."
    info "rollback a $objetivo hecho y sonda en verde"
    exit 0
  fi
  avisar "Quantum FM: ROLLBACK a $objetivo FALLIDO" \
    "Tras volver a $objetivo la sonda $(url_sonda) sigue en rojo. Producción caída: mirar journalctl --user -u $QFM_UNIT en $(hostname -s)."
  exit 1
}

main "$@"
